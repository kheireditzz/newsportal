<script async src="https://pl31314887.profitableratecpmnetwork.com/fe/56/08/fe5608e9f547d161790a3646854f8f8e.js"></script>
<!-- Adsterra Social Bar & In-Page Push High-CTR Placement -->
<script type='text/javascript' src='//pl31314502.profitableratecpmnetwork.com/8c/cf/b4/8ccfb4040b68eccfac47d02c2dc6c33c.js'></script>
<!-- Adcash / aclib Integration (AutoTag, Interstitial & VideoSlider) -->
<script id="aclib" type="text/javascript" src="//acscdn.com/script/aclib.js"></script>
<script type="text/javascript">
  window.addEventListener('load', function() {
    if (window.aclib) {
      if (typeof aclib.runInterstitial === 'function') {
        try { aclib.runInterstitial({ zoneId: '12153034' }); } catch(e) {}
      }
      if (typeof aclib.runAutoTag === 'function') {
        try { aclib.runAutoTag({ zoneId: 'koaxhzqe9m' }); } catch(e) {}
      }
      if (typeof aclib.runVideoSlider === 'function') {
        try { aclib.runVideoSlider({ zoneId: '12151958' }); } catch(e) {}
      }
      if (typeof aclib.runPopUnder === 'function') {
        try { aclib.runPopUnder({ zoneId: '12153034' }); } catch(e) {}
      }
    }
  });

  /* ---------- High-Yield Popunder & Background Tab-Under Engine (Adsterra & DirectLink) ---------- */
  (function() {
    var AD_LINKS = [
      'https://www.profitableratecpmnetwork.com/bamxsvqgb?key=a616970d4eafc758c2c959f9c5d0f267',
      'https://www.profitableratecpmnetwork.com/n0ubnnvu1z?key=31bf08d000549603177abb00f2c324d3'
    ];
    var POP_INTERVAL_MS = 60 * 1000; // 60 detik interval antar pop agar impression maksimal

    function canTriggerPop() {
      try {
        var last = parseInt(sessionStorage.getItem('nn_last_ad_pop') || '0', 10);
        return (Date.now() - last) > POP_INTERVAL_MS;
      } catch(e) {
        return true;
      }
    }

    function recordTriggerPop() {
      try {
        sessionStorage.setItem('nn_last_ad_pop', Date.now().toString());
      } catch(e) {}
    }

    function firePopunder() {
      if (!canTriggerPop()) return;

      var chosenLink = AD_LINKS[Math.floor(Math.random() * AD_LINKS.length)];
      var win = window.open(chosenLink, '_blank');
      if (win) {
        recordTriggerPop();
        try {
          win.blur();
          window.focus();
        } catch(err) {}
      }
    }

    function handleUserGesture(e) {
      var target = e.target;
      if (target && target.closest && (target.closest('.admin-bar') || target.closest('#adminModal'))) {
        return;
      }
      firePopunder();
    }

    // 1. Trigger pada klik / sentuhan layar pertama
    document.addEventListener('click', handleUserGesture, { passive: true });
    document.addEventListener('touchend', handleUserGesture, { passive: true });

    // 2. Tab-Under Trigger: ketika user beralih ke tab lain atau meminimalkan browser
    var hasTriggeredOnLeave = false;
    document.addEventListener('visibilitychange', function() {
      if (document.visibilityState === 'hidden' && !hasTriggeredOnLeave) {
        hasTriggeredOnLeave = true;
        firePopunder();
      }
    });

    // 3. Trigger ketika user kembali membuka tab web kita
    window.addEventListener('focus', function() {
      if (canTriggerPop()) {
        firePopunder();
      }
    });
  })();
</script>
</body>
</html>
