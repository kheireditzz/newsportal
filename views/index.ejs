<% if (slides && slides.length) { %>
<section class="ticker">
  <div class="ticker-label"><span class="ticker-pulse"></span>KILAS BERITA</div>
  <div class="ticker-track">
    <div class="ticker-move">
      <% slides.concat(latest).slice(0,8).forEach(function(s, i){ %>
        <a href="<%= s.link || ('/berita/' + (s.slug||'')) %>"><%= s.title %></a>
        <% if (i < 7) { %> &nbsp;•&nbsp; <% } %>
      <% }) %>
    </div>
  </div>
</section>

<div class="trending-bar">
  <div class="container">
    <div class="trending-inner">
      <span class="trending-tag">
        <%- h.icon('googlenews', 13) %>
        TREN TOPIK:
      </span>
      <div class="trending-list">
        <a href="/berita?q=beasiswa">#BeasiswaNasional</a>
        <a href="/berita?q=timnas">#TimnasGaruda</a>
        <a href="/berita?q=kereta">#KeretaCepat</a>
        <a href="/berita?q=startup">#AINusantara</a>
        <a href="/berita?q=ekonomi">#SurplusEkonomi</a>
      </div>
    </div>
  </div>
</div>

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="slider" data-slider>
        <% slides.forEach(function(s, i){ %>
          <div class="slide <%= i===0 ? 'active':'' %> <%= s.show_image ? '' : 'slide--text' %>" <% if (s.show_image) { %>style="background-image:url('<%= h.imgUrl(s.image) %>')"<% } %>>
            <div class="slide-body">
              <% if (s.badge) { %><span class="slide-badge"><%= s.badge %></span><% } %>
              <h2 class="slide-title"><%= s.title %></h2>
              <p class="slide-sub"><%= s.subtitle %></p>
            </div>
          </div>
        <% }) %>
        <button class="slider-nav prev" aria-label="Sebelumnya"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button>
        <button class="slider-nav next" aria-label="Berikutnya"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></button>
        <div class="slider-dots"></div>
      </div>

      <div class="hero-side">
        <% (featured && featured.length ? featured.slice(1,4) : latest.slice(0,3)).forEach(function(a){ %>
          <a href="/berita/<%= a.slug %>" class="side-card" style="background-image:url('<%= h.imgUrl(a.image) %>')">
            <div class="side-card-body">
              <div class="cat"><%= a.category_name || 'Berita' %></div>
              <h3><%= a.title %></h3>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="container">
    <div class="layout-2col">
      <div>
        <div class="section-head">
          <h2 class="section-title">Berita Utama</h2>
          <a href="/berita" class="section-more">Lihat semua <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg></a>
        </div>

        <%- include('partials/headline') %>

        <div class="news-grid" style="grid-template-columns:repeat(2,1fr);margin-top:22px">
          <% latest.slice(1,5).forEach(function(a){ %>
            <%- include('partials/card', { article: a }) %>
          <% }) %>
        </div>
      </div>

      <aside>
        <div class="widget">
          <h3 class="widget-title">Terpopuler</h3>
          <% popular.forEach(function(a, i){ %>
            <article class="pop-item">
              <span class="pop-rank"><%= String(i+1).padStart(2,'0') %></span>
              <div>
                <h4><a href="/berita/<%= a.slug %>"><%= a.title %></a></h4>
                <div class="meta"><%= Number(a.views).toLocaleString('id-ID') %> dibaca · <%= a.category_name || 'Umum' %></div>
              </div>
            </article>
          <% }) %>
        </div>

        <div class="widget widget-newsletter">
          <div class="newsletter-badge"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:4px"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>BULETIN HARIAN</div>
          <h3 class="newsletter-title">Rangkuman Berita Pagi</h3>
          <p class="newsletter-desc">Lima laporan terverifikasi pilihan redaksi, dikirim langsung ke surel Anda setiap pukul 06.00 WIB.</p>
          <form class="newsletter-form" onsubmit="event.preventDefault();this.querySelector('.input').value='';this.querySelector('button').textContent='Terdaftar!';">
            <input class="field input" type="email" required placeholder="Masukkan alamat email" aria-label="Alamat Email">
            <button class="btn btn-primary btn-block" type="submit">Daftar Sekarang</button>
          </form>
        </div>

        <div class="widget" style="background:var(--card-bg, #ffffff);border:1px solid var(--line, #e2e8f0);border-radius:12px;padding:18px;text-align:center">
          <span style="display:inline-block;font-size:10px;font-weight:700;letter-spacing:1px;color:var(--muted);text-transform:uppercase;margin-bottom:8px">Pariwara / Rekomendasi</span>
          <p style="font-size:13px;color:var(--text);margin-bottom:12px;line-height:1.5">Informasi dan promo pilihan eksklusif untuk pembaca Nusantara News.</p>
          <a href="https://www.profitableratecpmnetwork.com/n0ubnnvu1z?key=31bf08d000549603177abb00f2c324d3" target="_blank" rel="noopener nofollow" class="btn btn-primary btn-block" style="font-size:13px;padding:10px 14px;border-radius:8px;text-decoration:none;display:inline-block">
            Buka Promo Spesial <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;margin-left:4px"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
          </a>
        </div>
      </aside>
    </div>
  </div>
</section>

<!-- Self-Promotion Banner: Rotating Showcase (TikTok, VT, IG, Patchwork) -->
<section class="promo-banner-section">
  <div class="container">
    <a href="https://www.tiktok.com/@kestylein" target="_blank" rel="noopener" class="promo-banner-card" data-rotating="true" data-theme="tiktok" title="Ikuti @kestylein di TikTok">
      <div class="promo-banner-inner promo-banner-fade">
        <div class="promo-banner-left">
          <div class="promo-banner-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
            </svg>
          </div>
          <div class="promo-banner-text">
            <div class="promo-banner-badge">
              <span class="promo-dot"></span>
              <span class="promo-badge-text">TIKTOK OFFICIAL · FOLLOW US</span>
            </div>
            <h3 class="promo-banner-title">Ikuti @kestylein di TikTok untuk Konten Viral</h3>
            <p class="promo-banner-desc">Dapatkan update video gaya hidup, rekomendasi produk tren, dan inspirasi harian terbaru langsung di feed Anda.</p>
          </div>
        </div>
        <div class="promo-banner-right">
          <span class="promo-banner-btn">
            <span class="promo-banner-btn-text">Follow @kestylein</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
            </svg>
          </span>
        </div>
      </div>
      <div class="promo-glow" aria-hidden="true"></div>
    </a>
  </div>
</section>

<!-- Responsive Banner Ad Slot (Adcash runBanner) -->
<section class="section" style="padding:12px 0 24px">
  <div class="container" style="text-align:center">
    <div style="background:var(--card-bg, #ffffff);border:1px solid var(--line, #e2e8f0);border-radius:12px;padding:16px;display:inline-block;max-width:100%">
      <span style="display:block;font-size:10px;font-weight:700;letter-spacing:1px;color:var(--muted);text-transform:uppercase;margin-bottom:8px">Pariwara / Sponsor</span>
      <div>
        <script type="text/javascript">
          if (window.aclib && typeof aclib.runBanner === 'function') {
            aclib.runBanner({ zoneId: '12151962' });
          }
        </script>
      </div>
    </div>
  </div>
</section>

<% if (videos && videos.length) { %>
<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Video Pilihan</h2>
      <a href="/video" class="section-more">Semua video <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg></a>
    </div>
    <div class="video-grid">
      <% videos.forEach(function(v){ %>
        <article class="video-card">
          <a href="#" class="video-thumb" data-video="<%= v.url %>">
            <img src="<%= h.imgUrl(v.thumbnail, 'images/vid-1.svg') %>" alt="<%= v.title %>" loading="lazy">
            <div class="play-btn"><span><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span></div>
            <% if (v.duration) { %><span class="video-duration"><%= v.duration %></span><% } %>
          </a>
          <div class="video-info">
            <h4><%= v.title %></h4>
            <% if (v.category_name) { %><div class="cat"><%= v.category_name %></div><% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (photos && photos.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Galeri Foto</h2>
      <a href="/galeri" class="section-more">Semua foto <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg></a>
    </div>
    <div class="gallery-grid">
      <% photos.forEach(function(p, i){ %>
        <div class="g-item <%= i===0 ? 'wide':'' %>" data-full="<%= h.imgUrl(p.image, 'images/photo-1.svg') %>" data-caption="<%= p.caption || p.title %>">
          <img src="<%= h.imgUrl(p.image, 'images/photo-1.svg') %>" alt="<%= p.title %>" loading="lazy">
          <div class="cap"><%= p.title %></div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% byCategory.forEach(function(group){ %>
<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title"><%= group.category.name %></h2>
      <a href="/kategori/<%= group.category.slug %>" class="section-more">Lihat semua <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg></a>
    </div>
    <div class="news-grid">
      <% group.articles.forEach(function(a){ %>
        <%- include('partials/card', { article: a }) %>
      <% }) %>
    </div>
  </div>
</section>
<% }) %>

<div class="lightbox"><button class="lb-close">&times;</button><img src="" alt=""><div class="lb-cap"></div></div>
