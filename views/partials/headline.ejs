<% var first = (featured && featured[0]) || (latest && latest[0]); %>
<% if (first) { %>
<article class="card big">
  <a href="/berita/<%= first.slug %>" class="card-media">
    <img src="<%= h.imgUrl(first.image) %>" alt="<%= first.title %>">
    <span class="badge-featured">HEADLINE</span>
  </a>
  <div class="card-body">
    <h3 class="card-title"><a href="/berita/<%= first.slug %>"><%= first.title %></a></h3>
    <p class="card-excerpt"><%= h.truncate(first.excerpt || first.content, 240) %></p>
    <div class="card-meta">
      <% if (first.category_name) { %><span class="badge badge-cat"><%= first.category_name %></span><% } %>
      <span><%= h.formatDate(first.published_at || first.created_at, {time:true}) %></span>
      <span class="dot"></span>
      <span><%= Number(first.views || 0).toLocaleString('id-ID') %> kali dibaca</span>
      <button type="button" class="card-share-btn" data-title="<%= first.title %>" data-url="/berita/<%= first.slug %>" title="Bagikan Berita Utama Ini" aria-label="Bagikan Berita">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      </button>
    </div>
  </div>
</article>
<% } %>
