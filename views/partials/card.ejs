<article class="card">
  <a href="/berita/<%= article.slug %>" class="card-media">
    <img src="<%= h.imgUrl(article.image) %>" alt="<%= article.title %>" loading="lazy">
    <% if (article.category_name) { %><span class="card-cat"><%= article.category_name %></span><% } %>
    <% if (article.featured) { %><span class="badge-featured">UTAMA</span><% } %>
  </a>
  <div class="card-body">
    <h3 class="card-title"><a href="/berita/<%= article.slug %>"><%= article.title %></a></h3>
    <p class="card-excerpt"><%= h.truncate(article.excerpt || article.content, 135) %></p>
    <div class="card-meta">
      <span><%= h.timeAgo(article.published_at || article.created_at) %></span>
      <span class="dot"></span>
      <span><%= h.formatDate(article.published_at || article.created_at) %></span>
      <span class="dot"></span>
      <span><%= Number(article.views || 0).toLocaleString('id-ID') %> dibaca</span>
      <button type="button" class="card-share-btn" data-title="<%= article.title %>" data-url="/berita/<%= article.slug %>" title="Bagikan Berita Ini" aria-label="Bagikan Berita">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      </button>
    </div>
  </div>
</article>
