<!-- Schema.org NewsArticle Structured Data for Google Search & News -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": <%= JSON.stringify(article.title) %>,
  "description": <%= JSON.stringify(article.excerpt || article.title) %>,
  "image": [
    "<%= (article.image && (article.image.startsWith('http://') || article.image.startsWith('https://'))) ? article.image : ((typeof canonical !== 'undefined' ? canonical.replace(/\/berita\/.*/, '') : '') + h.imgUrl(article.image)) %>"
  ],
  "datePublished": "<%= new Date(String(article.published_at || article.created_at || '').replace(' ', 'T')).toISOString() %>",
  "dateModified": "<%= new Date(String(article.updated_at || article.published_at || article.created_at || '').replace(' ', 'T')).toISOString() %>",
  "author": [{
    "@type": "Person",
    "name": "<%= article.author_name || 'Redaksi Nusantara' %>"
  }],
  "publisher": {
    "@type": "NewsMediaOrganization",
    "name": "<%= settings.site_name || 'Nusantara News' %>"
  }
}
</script>

<section class="page-hero" style="padding:28px 0 32px">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Beranda</a>
      <span class="crumb-sep">/</span>
      <a href="/berita">Berita</a>
      <% if (article.category_slug) { %>
        <span class="crumb-sep">/</span>
        <a href="/kategori/<%= article.category_slug %>"><%= article.category_name %></a>
      <% } %>
    </nav>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="container">
    <div class="layout-2col article-layout">
      <article class="article-wrap" id="mainArticle">
        <header class="article-header">
          <% if (article.category_name) { %>
            <div class="article-cat-wrap">
              <a href="/kategori/<%= article.category_slug %>" class="cat" style="background:<%= article.category_color %>18;color:<%= article.category_color %>;border:1px solid <%= article.category_color %>30">
                <span class="cat-dot" style="background:<%= article.category_color %>"></span>
                <%= article.category_name %>
              </a>
            </div>
          <% } %>

          <h1 class="article-title serif"><%= article.title %></h1>

          <% if (article.excerpt) { %>
            <p class="article-lead"><%= article.excerpt %></p>
          <% } %>

          <div class="article-meta-bar">
            <div class="meta-left">
              <span class="meta-avatar"><%= (article.author_name || 'R').charAt(0).toUpperCase() %></span>
              <div class="meta-names">
                <span class="author-name"><%= article.author_name || 'Redaksi Nusantara' %></span>
                <span class="pub-date"><%= h.formatDate(article.published_at || article.created_at, {time:true}) %></span>
              </div>
            </div>
            <div class="meta-right">
              <span class="meta-pill" title="Estimasi Waktu Baca">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span><%= h.readingTime(article.content) %></span>
              </span>
              <span class="meta-pill" title="Total Pembaca">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <span><%= Number(article.views || 0).toLocaleString('id-ID') %> dibaca</span>
              </span>
            </div>
          </div>

          <!-- Interactive Reading Timer & Controls Toolbar -->
          <div class="reader-companion-toolbar">
            <div class="reader-timer-widget" id="readingTimerBox" title="Timer Waktu Membaca">
              <span class="timer-live-dot"></span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span class="timer-title">Waktu Baca:</span>
              <span class="timer-digits mono" id="liveReadingTimer">00:00</span>
              <span class="timer-rem" id="readingTimeRemaining">· Sisa: ~<%= h.readingTime(article.content) %></span>
              <button type="button" class="btn-timer-toggle" id="btnToggleTimer" aria-label="Jeda / Lanjutkan Timer" title="Jeda / Lanjutkan Timer">
                <svg id="timerIconPause" width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                <svg id="timerIconPlay" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" style="display:none"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              </button>
            </div>

            <div class="reader-tools-right">
              <!-- Audio Reader (Text-to-Speech) -->
              <button type="button" class="tool-btn btn-audio-reader" id="btnAudioReader" title="Dengarkan pembacaan berita">
                <svg class="audio-play-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
                <span id="audioReaderLabel">Dengarkan</span>
                <span class="audio-equalizer" id="audioEqualizer" style="display:none">
                  <i></i><i></i><i></i>
                </span>
              </button>

              <!-- Focus Mode Toggle -->
              <button type="button" class="tool-btn" id="btnFocusMode" title="Mode Fokus Membaca">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
                <span class="hide-mobile">Fokus</span>
              </button>

              <!-- Font Size Resizer -->
              <div class="font-resizer-group" title="Ubah Ukuran Huruf">
                <button type="button" class="btn-resize" id="fontDec" aria-label="Perkecil Ukuran Huruf">A-</button>
                <button type="button" class="btn-resize active" id="fontReset" aria-label="Ukuran Huruf Standar">A</button>
                <button type="button" class="btn-resize" id="fontInc" aria-label="Perbesar Ukuran Huruf">A+</button>
              </div>

              <!-- Print Action -->
              <button type="button" class="tool-btn" onclick="window.print()" title="Cetak Artikel" aria-label="Cetak">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
              </button>
            </div>
          </div>
        </header>

        <!-- Featured / Cover Image -->
        <div class="article-hero-img">
          <img src="<%= h.imgUrl(article.image) %>" alt="<%= article.title %>" loading="lazy">
          <% if (article.caption) { %>
            <figcaption class="hero-img-caption"><%= article.caption %></figcaption>
          <% } %>
        </div>

        <!-- Article Main Content with High-Legibility Typography -->
        <div class="article-content serif-body" id="articleBody">
          <%- article.content %>
        </div>

        <!-- Author Bio Card -->
        <div class="author-bio-card">
          <div class="author-avatar-big"><%= (article.author_name || 'R').charAt(0).toUpperCase() %></div>
          <div class="author-info">
            <div class="author-label">REDAKSI NUSANTARA NEWS</div>
            <h4 class="author-fullname"><%= article.author_name || 'Tim Redaksi Nusantara News' %></h4>
            <p class="author-bio-txt">Menyajikan liputan berita terverifikasi, independen, dan berimbang dari pelosok tanah air dan mancanegara.</p>
          </div>
        </div>

        <!-- Self-Promotion Banner: Rotating Showcase (TikTok, VT, IG, Patchwork) -->
        <div style="margin: 28px 0 16px;">
          <a href="https://www.tiktok.com/@kestylein" target="_blank" rel="noopener" class="promo-banner-card" data-rotating="true" data-theme="tiktok" title="Ikuti @kestylein di TikTok">
            <div class="promo-banner-inner promo-banner-fade">
              <div class="promo-banner-left">
                <div class="promo-banner-icon" aria-hidden="true">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                  </svg>
                </div>
                <div class="promo-banner-text">
                  <div class="promo-banner-badge">
                    <span class="promo-dot"></span>
                    <span class="promo-badge-text">TIKTOK OFFICIAL · FOLLOW US</span>
                  </div>
                  <h3 class="promo-banner-title">Ikuti @kestylein di TikTok untuk Konten Viral</h3>
                  <p class="promo-banner-desc">Dapatkan update video gaya hidup, rekomendasi produk tren, dan inspirasi harian terbaru langsung di feed Anda.</p>
                </div>
              </div>
              <div class="promo-banner-right">
                <span class="promo-banner-btn">
                  <span class="promo-banner-btn-text">Follow TikTok ↗</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
                  </svg>
                </span>
              </div>
            </div>
            <div class="promo-glow" aria-hidden="true"></div>
          </a>
        </div>

        <!-- Sponsored / Advertisement Banner (Non-intrusive Reader Slot) -->
        <div class="ad-slot-wrapper">
          <div class="ad-slot-card">
            <span class="ad-slot-label">Pariwara / Sponsor</span>
            <div class="ad-slot-content">
              <script>
                atOptions = {
                  'key' : 'a4c3b4dd04f8b05384ab2c8031d1e854',
                  'format' : 'iframe',
                  'height' : 60,
                  'width' : 468,
                  'params' : {}
                };
              </script>
              <script src="https://www.highrevenueformat.com/a4c3b4dd04f8b05384ab2c8031d1e854/invoke.js"></script>
              <div style="margin-top:12px">
                <script type="text/javascript">
                  if (window.aclib && typeof aclib.runBanner === 'function') {
                    aclib.runBanner({ zoneId: '12151962' });
                  }
                </script>
              </div>
            </div>
            <div style="margin-top:10px;text-align:center">
              <a href="https://www.profitableratecpmnetwork.com/bamxsvqgb?key=a616970d4eafc758c2c959f9c5d0f267" target="_blank" rel="noopener nofollow" style="font-size:12px;color:var(--primary);font-weight:600;text-decoration:none">
                ✦ Jelajahi Informasi &amp; Promo Rekomendasi Terkini &raquo;
              </a>
            </div>
          </div>
        </div>

        <!-- Social Share Bar -->
        <div class="share-bar">
          <span class="share-title">Bagikan Berita:</span>
          <div class="share-btn-group">
            <a class="share-btn share-wa" href="https://wa.me/?text=<%= encodeURIComponent(article.title + ' ' + (typeof fullUrl !== 'undefined' ? fullUrl : '')) %>" target="_blank" rel="noopener" aria-label="Bagikan ke WhatsApp" title="WhatsApp">
              <%- h.icon('whatsapp', 17) %>
              <span>WhatsApp</span>
            </a>
            <a class="share-btn share-x" href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(article.title) %>" target="_blank" rel="noopener" aria-label="Bagikan ke X" title="X (Twitter)">
              <%- h.icon('x', 15) %>
              <span>X</span>
            </a>
            <a class="share-btn share-fb" href="https://www.facebook.com/sharer/sharer.php" target="_blank" rel="noopener" aria-label="Bagikan ke Facebook" title="Facebook">
              <%- h.icon('facebook', 17) %>
              <span>Facebook</span>
            </a>
            <a class="share-btn share-tg" href="https://t.me/share/url?text=<%= encodeURIComponent(article.title) %>" target="_blank" rel="noopener" aria-label="Bagikan ke Telegram" title="Telegram">
              <%- h.icon('telegram', 17) %>
              <span>Telegram</span>
            </a>
            <button type="button" class="share-btn share-copy" id="btnCopyLink" aria-label="Salin Tautan" title="Salin Tautan Artikel">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              <span>Salin Link</span>
            </button>
          </div>
        </div>

        <!-- Sponsored Container Ad Unit (Above Related Articles) -->
        <div class="ad-slot-wrapper" style="margin:24px 0 32px">
          <div class="ad-slot-card">
            <span class="ad-slot-label">Rekomendasi Mitra</span>
            <div class="ad-slot-content">
              <script async="async" data-cfasync="false" src="https://pl31314502.profitableratecpmnetwork.com/8ccfb4040b68eccfac47d02c2dc6c33c/invoke.js"></script>
              <div id="container-8ccfb4040b68eccfac47d02c2dc6c33c"></div>
            </div>
          </div>
        </div>

        <!-- Related News Grid -->
        <% if (related && related.length) { %>
          <div class="related-section">
            <div class="section-head">
              <h2 class="section-title">
                <span class="title-accent"></span>
                Berita Terkait
              </h2>
            </div>
            <div class="news-grid news-grid-3">
              <% related.forEach(function(a){ %>
                <%- include('partials/card', { article: a }) %>
              <% }) %>
            </div>
          </div>
        <% } %>
      </article>

      <!-- Sidebar -->
      <aside class="article-sidebar" id="articleSidebar">
        <!-- Widget Terpopuler -->
        <div class="widget">
          <h3 class="widget-title">
            <span class="widget-title-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></span>
            Terpopuler
          </h3>
          <div class="pop-list">
            <% popular.forEach(function(a, i){ %>
              <article class="pop-item">
                <span class="pop-rank"><%= String(i+1).padStart(2,'0') %></span>
                <div class="pop-content">
                  <h4 class="pop-title"><a href="/berita/<%= a.slug %>"><%= a.title %></a></h4>
                  <div class="pop-meta">
                    <span><%= Number(a.views || 0).toLocaleString('id-ID') %> dibaca</span>
                    <span>·</span>
                    <span><%= h.readingTime(a.content) %></span>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        </div>

        <!-- Widget Kategori -->
        <div class="widget">
          <h3 class="widget-title">
            <span class="widget-title-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg></span>
            Kategori Berita
          </h3>
          <div class="category-widget-list">
            <% categories.forEach(function(c){ %>
              <a href="/kategori/<%= c.slug %>" class="cat-widget-item">
                <span class="cat-widget-name">
                  <span class="cat-color-dot" style="background:<%= c.color || '#2563eb' %>"></span>
                  <%= c.name %>
                </span>
                <span class="cat-widget-arrow">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
                </span>
              </a>
            <% }) %>
          </div>
        </div>

        <!-- Widget Sponsor / Rekomendasi Khusus -->
        <div class="widget" style="background:var(--card-bg, #ffffff);border:1px solid var(--line, #e2e8f0);border-radius:12px;padding:18px;text-align:center">
          <span style="display:inline-block;font-size:10px;font-weight:700;letter-spacing:1px;color:var(--muted);text-transform:uppercase;margin-bottom:8px">Pariwara Pilihan</span>
          <p style="font-size:13px;color:var(--text);margin-bottom:12px;line-height:1.5">Temukan penawaran khusus dan informasi menarik dari mitra terpercaya kami.</p>
          <a href="https://www.profitableratecpmnetwork.com/n0ubnnvu1z?key=31bf08d000549603177abb00f2c324d3" target="_blank" rel="noopener nofollow" class="btn btn-primary btn-block" style="font-size:13px;padding:10px 14px;border-radius:8px;text-decoration:none;display:inline-block">
            Lihat Penawaran <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;margin-left:4px"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
          </a>
        </div>
      </aside>
    </div>
  </div>
</section>

<!-- Floating Reader Companion Bar (Appears on Scroll) -->
<div class="floating-reader-bar" id="floatingReaderBar">
  <div class="fr-container">
    <div class="fr-title" id="frTitle"><%= article.title %></div>
    <div class="fr-center">
      <span class="fr-timer" id="frTimer">⏱️ 00:00</span>
      <span class="fr-progress" id="frProgress">0% selesai</span>
    </div>
    <div class="fr-actions">
      <button type="button" class="fr-btn" id="frAudioBtn" title="Dengarkan Berita">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
        <span>Audio</span>
      </button>
      <button type="button" class="fr-btn" id="frTopBtn" title="Kembali ke atas">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m18 15-6-6-6 6"/></svg>
      </button>
    </div>
  </div>
</div>
