<%
  var msgs = {
    'backup-ok': ['Cadangan berhasil dibuat.', true],
    'backup-fail': ['Gagal membuat cadangan.', false],
    'import-ok': ['Data berhasil dipulihkan.', true],
    'import-fail': ['Gagal memulihkan data. Periksa file cadangan.', false],
    'import-no-file': ['Pilih file cadangan terlebih dahulu.', false]
  };
  var m = msg && msgs[msg];
%>
<div class="page-head">
  <div>
    <h2>Cadangan Data</h2>
    <div class="desc">Buat, unduh, dan pulihkan salinan data database situs.</div>
  </div>
  <span class="badge badge-muted"><%= backups.length %> cadangan</span>
</div>

<% if (m) { %>
  <div class="alert <%= m[1] ? 'alert-success' : 'alert-error' %>" style="margin-bottom:18px"><%= m[0] %></div>
<% } %>

<div class="grid-2">
  <div class="panel">
    <div class="panel-head">
      <h3><span class="hd-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></span> Riwayat Cadangan</h3>
    </div>
    <div class="panel-body flush">
      <% if (!backups.length) { %>
        <div class="empty-state" style="padding:48px 16px">
          <div class="big"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9"/><path d="M21 3v6h-6"/></svg></div>
          <p>Belum ada cadangan.</p>
          <small>Anda bisa membuat cadangan pertama lewat tombol di samping.</small>
        </div>
      <% } else { %>
        <div class="backup-list">
          <% backups.forEach(function(b){ %>
          <div class="backup-item">
            <span class="b-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
            <div class="b-main">
              <b class="mono"><%= b.name %></b>
              <small><%= (b.size / 1024).toFixed(1) %> KB · <%= h.formatDate(b.mtime.toISOString(), { time: true }) %></small>
            </div>
            <div class="cell-actions">
              <a href="/admin/pencadangan/backup" class="btn btn-ghost btn-sm">Unduh</a>
              <form action="/admin/pencadangan/delete/<%= encodeURIComponent(b.name) %>" method="POST" data-confirm="Hapus cadangan ini?">
                <button class="btn btn-danger btn-sm btn-icon" type="submit" title="Hapus">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M19 6l-1 15a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1L5 6"/></svg>
                </button>
              </form>
            </div>
          </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <div>
    <div class="panel">
      <div class="panel-head">
        <h3><span class="hd-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span> Buat Cadangan</h3>
      </div>
      <div class="panel-body">
        <p class="bd-hint">Snapshot instan seluruh data (artikel, kategori, video, galeri, slide, pesan, dan pengaturan) disimpan ke folder <code>data/backups</code>.</p>
        <form action="/admin/pencadangan/backup" method="POST">
          <button class="btn btn-primary btn-block" type="submit" style="justify-content:center">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/></svg>
            Cadangkan Sekarang
          </button>
        </form>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">
        <h3><span class="hd-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg></span> Pulihkan dari File</h3>
      </div>
      <div class="panel-body">
        <p class="bd-hint">Unggah file <code>.db</code> hasil cadangan untuk menimpa data saat ini. Salinan otomatis (<code>before-import-*.db</code>) dibuat sebelum dipulihkan.</p>
        <form action="/admin/pencadangan/import" method="POST" enctype="multipart/form-data" data-confirm="Pulihkan data dari file ini? Data saat ini akan diganti (salinan aman dibuat otomatis).">
          <label class="img-drop" style="margin-bottom:12px">
            <div class="prev">Pilih file .db</div>
            <input type="file" name="file" accept=".db" required>
            <div class="txt"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3M17 8l-5-5-5 5M12 3v12"/></svg>Unggah cadangan</div>
          </label>
          <button class="btn btn-danger btn-block" type="submit" style="justify-content:center">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Pulihkan Data
          </button>
        </form>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">
        <h3><span class="hd-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span> Tips Keamanan</h3>
      </div>
      <div class="panel-body">
        <ul class="bd-tips">
          <li>Buat cadangan sebelum pembaruan konten besar.</li>
          <li>Unduh cadangan ke perangkat pribadi secara berkala.</li>
          <li>12 cadangan terakhir disimpan otomatis; yang lebih lama dibersihkan.</li>
        </ul>
      </div>
    </div>
  </div>
</div>