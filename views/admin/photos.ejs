<div class="page-head">
  <div>
    <h2>Galeri Foto</h2>
    <div class="desc">Seret gagang ⠿ untuk mengatur urutan foto pada halaman galeri.</div>
  </div>
</div>

<div class="grid-2">
  <div class="panel">
    <div class="panel-head">
      <h3><span class="hd-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-4.5-4.5L7 21"/></svg></span> Daftar Foto</h3>
      <span class="badge badge-muted"><%= photos.length %> foto</span>
    </div>
    <div class="panel-body">
      <% if (!photos.length) { %>
        <div class="empty-state"><div class="big"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-4.5-4.5L7 21"/></svg></div>Belum ada foto.</div>
      <% } else { %>
      <div class="sortable-list" data-sortable data-sortable-url="/api/admin/reorder/photos">
        <% photos.forEach(function(p, i){ %>
        <div class="sortable-item" data-sort-id="<%= p.id %>">
          <span class="drag-handle" title="Seret untuk mengurutkan" aria-label="Seret untuk mengurutkan">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" stroke="none"><circle cx="9" cy="5" r="1.4"/><circle cx="15" cy="5" r="1.4"/><circle cx="9" cy="12" r="1.4"/><circle cx="15" cy="12" r="1.4"/><circle cx="9" cy="19" r="1.4"/><circle cx="15" cy="19" r="1.4"/></svg>
          </span>
          <span class="tab-num"><%= String(i + 1).padStart(2, '0') %></span>
          <div class="cell-title">
            <img class="thumb" src="<%= h.imgUrl(p.image) %>" alt="">
            <div>
              <b><a href="/galeri" target="_blank" rel="noopener"><%= p.title %></a></b>
              <small><%= h.truncate(p.caption, 55) %></small>
            </div>
          </div>
          <span class="badge badge-muted col-meta"><%= p.album %></span>
          <div class="col-status">
            <% if (p.status === 'published') { %><span class="badge badge-published">Terbit</span>
            <% } else { %><span class="badge badge-draft">Draf</span><% } %>
          </div>
          <div class="cell-actions">
            <form action="/admin/galeri/<%= p.id %>/delete" method="POST" data-confirm="Hapus foto ini?">
              <button class="btn btn-danger btn-sm btn-icon" type="submit" title="Hapus">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M19 6l-1 15a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1L5 6"/></svg>
              </button>
            </form>
          </div>
        </div>
        <% }) %>
      </div>
      <div class="sortable-footer">
        <span class="clean">Urutan tersimpan otomatis.</span>
        <span class="dirty"><span class="dot dot-warn"></span> Menyimpan...</span>
      </div>
      <% } %>
    </div>
  </div>

  <div>
    <div class="panel">
      <div class="panel-head">
        <h3><span class="hd-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span> Unggah Foto</h3>
      </div>
      <div class="panel-body">
        <form action="/admin/galeri" method="POST" enctype="multipart/form-data">
          <div class="field">
            <label for="title">Judul Foto <span class="req">*</span></label>
            <input class="input" type="text" id="title" name="title" required placeholder="Judul foto">
          </div>
          <div class="field">
            <label for="caption">Keterangan</label>
            <textarea class="textarea" id="caption" name="caption" style="min-height:84px" placeholder="Keterangan foto..."></textarea>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="album">Album</label>
              <input class="input" type="text" id="album" name="album" placeholder="mis. Peristiwa">
            </div>
            <div class="field">
              <label for="status">Status</label>
              <select class="select" id="status" name="status">
                <option value="published">Terbit</option>
                <option value="draft">Draf</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label>Gambar <span class="req">*</span></label>
            <label class="img-drop">
              <div class="prev">Klik untuk memilih gambar</div>
              <input type="file" name="image" accept="image/*">
              <div class="txt"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3M17 8l-5-5-5 5M12 3v12"/></svg>Pilih dari perangkat</div>
            </label>
            <div class="v-stack" style="margin-top:10px">
              <button type="button" class="btn btn-ghost btn-sm" data-edit-image>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z"/><path d="m15 5 4 4"/></svg>
                Crop / Atur Ukuran Gambar
              </button>
            </div>
            <input class="input" type="text" name="image_url" placeholder="atau URL gambar" style="margin-top:12px">
            <%- include('../partials/media-editor', { editorId: 'media-editor-photo' }) %>
          </div>
          <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center">Unggah Foto</button>
        </form>
      </div>
    </div>
  </div>
</div>