<div class="page-head">
  <div>
    <h2>Detail Pesan</h2>
    <div class="desc">Baca dan balas pesan pengunjung.</div>
  </div>
  <a href="/admin/pesan" class="btn btn-ghost btn-sm">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    Kembali
  </a>
</div>

<div class="panel" style="max-width:820px">
  <div class="panel-head">
    <div>
      <h3><%= message.subject || '(Tanpa Subjek)' %></h3>
      <small class="text-muted"><%= h.formatDate(message.created_at, { time: true }) %></small>
    </div>
  </div>
  <div class="panel-body">
    <div style="display:flex;align-items:center;gap:14px;padding-bottom:18px;border-bottom:1px solid var(--a-line);margin-bottom:20px">
      <div class="av" style="width:50px;height:50px;border-radius:14px;background:linear-gradient(135deg,var(--a-ink),#33475c);color:#fff;display:grid;place-items:center;font-weight:800;font-size:19px"><%= message.name.charAt(0).toUpperCase() %></div>
      <div>
        <b style="font-size:15px;color:var(--a-ink)"><%= message.name %></b><br>
        <a href="mailto:<%= message.email %>" class="text-brand" style="font-size:13.5px"><%= message.email %></a>
      </div>
    </div>
    <div style="font-size:14.5px;line-height:1.85;white-space:pre-wrap;color:var(--a-ink-2)"><%= message.body %></div>
  </div>
  <div class="panel-head" style="border-top:1px solid var(--a-line);justify-content:flex-end">
    <div style="display:flex;gap:10px">
      <a href="mailto:<%= message.email %>?subject=Re: <%= encodeURIComponent(message.subject || '') %>" class="btn btn-primary btn-sm">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="m22 2-11 11M22 2l-7 20-4-9-9-4z"/></svg>
        Balas via Email
      </a>
      <form action="/admin/pesan/<%= message.id %>/delete" method="POST" data-confirm="Hapus pesan ini?">
        <button class="btn btn-danger btn-sm" type="submit">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M19 6l-1 15a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1L5 6"/></svg>
          Hapus
        </button>
      </form>
    </div>
  </div>
</div>