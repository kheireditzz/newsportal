<style>
  /* Premium Ad Analytics Theme - High Human Craft */
  .ad-analytics-wrapper {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Provider Switcher Tabs */
  .provider-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px;
    background: #ffffff;
    border: 1px solid var(--a-line);
    border-radius: 14px;
    box-shadow: var(--a-shadow-sm);
    width: fit-content;
  }
  .provider-tab {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 18px;
    border-radius: 10px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--a-muted);
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }
  .provider-tab:hover {
    color: var(--a-ink);
    background: var(--a-line-2);
  }
  .provider-tab.active {
    background: var(--a-side);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(11, 17, 24, 0.25);
  }
  .provider-tab .dot-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  /* Key Info Box (Click-to-reveal) */
  .api-badge-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--a-line);
    padding: 12px 18px;
    border-radius: 12px;
    box-shadow: var(--a-shadow-sm);
    flex-wrap: wrap;
    gap: 12px;
  }
  .key-reveal-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--a-line-2);
    border: 1px dashed var(--a-line);
    padding: 6px 14px;
    border-radius: 8px;
    font-family: var(--a-mono);
    font-size: 12px;
    color: var(--a-ink-2);
    cursor: pointer;
    user-select: none;
    transition: all 0.15s;
  }
  .key-reveal-pill:hover {
    background: #e2e8f0;
    border-color: #cbd5e1;
  }

  /* Metric KPI Cards */
  .metrics-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  @media (max-width: 900px) {
    .metrics-container { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .metrics-container { grid-template-columns: 1fr; }
  }

  .metric-box {
    background: #ffffff;
    border: 1px solid var(--a-line);
    border-radius: 14px;
    padding: 20px;
    position: relative;
    overflow: hidden;
    box-shadow: var(--a-shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .metric-box:hover {
    transform: translateY(-2px);
    box-shadow: var(--a-shadow);
  }
  .metric-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--box-accent, var(--a-brand));
  }
  .metric-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .metric-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--icon-bg, var(--a-line-2));
    color: var(--box-accent, var(--a-brand));
  }
  .metric-tag {
    font-size: 11.5px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--icon-bg, var(--a-line-2));
    color: var(--box-accent, var(--a-brand));
  }
  .metric-num {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--a-ink);
    line-height: 1.15;
    margin-bottom: 4px;
    font-feature-settings: "tnum";
  }
  .metric-lbl {
    font-size: 12.5px;
    color: var(--a-muted);
    font-weight: 500;
  }

  /* Time Filter Pills */
  .time-nav {
    display: inline-flex;
    background: #ffffff;
    border: 1px solid var(--a-line);
    border-radius: 10px;
    padding: 3px;
    box-shadow: var(--a-shadow-sm);
  }
  .time-pill {
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--a-muted);
    text-decoration: none;
    transition: all 0.15s;
  }
  .time-pill:hover { color: var(--a-ink); }
  .time-pill.active {
    background: var(--a-brand);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(227, 0, 43, 0.35);
  }

  /* Table Polish */
  .ad-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .ad-table th {
    text-align: left;
    padding: 12px 16px;
    background: #f8fafc;
    color: var(--a-muted);
    font-weight: 700;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--a-line);
  }
  .ad-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--a-line-2);
    vertical-align: middle;
  }
  .ad-table tbody tr:hover {
    background: #fbfcfe;
  }
  .ad-table tbody tr:last-child td {
    border-bottom: none;
  }
</style>

<div class="ad-analytics-wrapper">
  <!-- Page Header -->
  <div class="page-head" style="margin-bottom:0">
    <div>
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px">
        <h2 style="margin:0;font-weight:800;font-size:24px;letter-spacing:-0.02em">Statistik Iklan &amp; Monetisasi</h2>
        <span class="badge" style="background:#e0f2fe;color:#0369a1;font-weight:700">Reporting API v2/v3</span>
      </div>
      <div class="desc" style="color:var(--a-muted);font-size:13.5px">Dashboard analitik real-time dari jaringan iklan Adsterra Network &amp; Adcash Publisher.</div>
    </div>
    <div class="h-stack">
      <a href="/admin/statistik-iklan?provider=<%= provider %>&period=<%= period %>&refresh=1" class="btn btn-ghost btn-sm" style="border-radius:9px;background:#ffffff;border:1px solid var(--a-line)" title="Ambil data baru langsung dari server API">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.19"/></svg>
        <span>Perbarui Data</span>
      </a>
      <button type="button" class="btn btn-primary btn-sm" style="border-radius:9px" onclick="document.getElementById('apiConfigModal').classList.add('open')">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span>Kelola Kunci API</span>
      </button>
    </div>
  </div>

  <!-- Status Alert Messages -->
  <% if (msg === 'token-saved') { %>
    <div class="alert alert-success" style="padding:12px 16px;border-radius:10px;background:var(--a-success-bg);color:var(--a-success);border:1px solid rgba(15,157,88,0.25);display:flex;align-items:center;gap:10px">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
      <span style="font-weight:600;font-size:13.5px">Kunci API berhasil disimpan dengan aman (Terenkripsi AES-256-GCM di database).</span>
    </div>
  <% } %>

  <!-- Top Bar: Provider Switcher + API Key Reveal Widget -->
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px">
    <!-- Provider Selection Tab -->
    <div class="provider-nav">
      <a href="/admin/statistik-iklan?provider=adsterra&period=<%= period %>" class="provider-tab <%= provider === 'adsterra' ? 'active' : '' %>">
        <span class="dot-indicator" style="background:<%= provider === 'adsterra' ? '#10b981' : '#cbd5e1' %>"></span>
        <span>Adsterra Network</span>
        <span style="font-size:11px;opacity:0.75;padding:1px 6px;border-radius:4px;background:rgba(255,255,255,0.15)">v3 API</span>
      </a>

      <a href="/admin/statistik-iklan?provider=adcash&period=<%= period %>" class="provider-tab <%= provider === 'adcash' ? 'active' : '' %>">
        <span class="dot-indicator" style="background:<%= provider === 'adcash' ? '#3b82f6' : '#cbd5e1' %>"></span>
        <span>Adcash Publisher</span>
        <span style="font-size:11px;opacity:0.75;padding:1px 6px;border-radius:4px;background:rgba(255,255,255,0.15)">v2 Auth</span>
      </a>
    </div>

    <!-- Click-to-Reveal API Key Card -->
    <div class="api-badge-card">
      <div style="display:flex;align-items:center;gap:8px;font-size:13px">
        <span style="color:var(--a-muted)">Kunci Aktif (<%= provider === 'adcash' ? 'Adcash' : 'Adsterra' %>):</span>
        <% const rawActiveKey = (provider === 'adcash' ? adcashToken : adsterraToken) || ''; %>
        <div class="key-reveal-pill" id="keyRevealBox" onclick="toggleKeyVisibility()" title="Klik untuk menampilkan / menyembunyikan API Key">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span id="keyMaskedText">••••••••••••••••••••••••</span>
          <span id="keyActualText" style="display:none"><%= rawActiveKey ? rawActiveKey.slice(0, 16) + '…' + rawActiveKey.slice(-8) : 'Belum ada token' %></span>
          <span style="font-size:10.5px;font-weight:700;color:var(--a-brand);text-transform:uppercase" id="keyActionText">Klik Buka</span>
        </div>
      </div>
      <% if (report && report.cached) { %>
        <span style="font-size:12px;color:var(--a-muted);display:inline-flex;align-items:center;gap:5px;background:#f1f5f9;padding:4px 8px;border-radius:6px">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Cache Aktif (<%= new Date(report.cacheTime).toLocaleTimeString('id-ID') %>)
        </span>
      <% } %>
    </div>
  </div>

  <% if (report && report.error) { %>
    <div class="alert alert-danger" style="padding:18px 22px;border-radius:12px;background:#fff5f5;color:#991b1b;border:1px solid #fed7d7;display:flex;align-items:flex-start;gap:14px;box-shadow:var(--a-shadow-sm)">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <div style="flex:1">
        <b style="display:block;font-size:15px;margin-bottom:4px">Koneksi API <%= provider === 'adcash' ? 'Adcash' : 'Adsterra' %> Gagal</b>
        <p style="margin:0;font-size:13.5px;line-height:1.5;color:#7f1d1d"><%= report.error %></p>
        <div style="margin-top:12px">
          <button type="button" class="btn btn-sm btn-ghost" onclick="document.getElementById('apiConfigModal').classList.add('open')" style="color:#991b1b;border-color:#fca5a5;background:#ffffff;font-weight:600">Perbarui Kunci API</button>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Period Filter & Balance / Meta -->
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-top:4px">
    <div class="time-nav">
      <a href="/admin/statistik-iklan?provider=<%= provider %>&period=today" class="time-pill <%= period === 'today' ? 'active' : '' %>">Hari Ini</a>
      <a href="/admin/statistik-iklan?provider=<%= provider %>&period=week" class="time-pill <%= period === 'week' ? 'active' : '' %>">7 Hari Terakhir</a>
      <a href="/admin/statistik-iklan?provider=<%= provider %>&period=month" class="time-pill <%= period === 'month' ? 'active' : '' %>">30 Hari Terakhir</a>
    </div>

    <div style="display:flex;align-items:center;gap:12px;font-size:13px">
      <% if (report && report.balance !== null && report.balance !== undefined) { %>
        <div style="background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0;padding:6px 14px;border-radius:8px;font-weight:700;display:inline-flex;align-items:center;gap:8px">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>
          Saldo Akun: $<%= Number(report.balance).toFixed(2) %> <%= report.balanceCurrency %>
        </div>
      <% } %>
      <% if (report && report.dbLastUpdateTime) { %>
        <span style="color:var(--a-muted);font-size:12px">Sync API: <b><%= report.dbLastUpdateTime %></b></span>
      <% } %>
    </div>
  </div>

  <!-- 4 Ringkasan Kartu KPI (Clean High Density) -->
  <div class="metrics-container">
    <!-- KPI 1: Impressions / Visitors -->
    <div class="metric-box" style="--box-accent:#2563eb;--icon-bg:#eff6ff">
      <div class="metric-top">
        <div class="metric-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
        <span class="metric-tag"><%= provider === 'adcash' ? 'Pengunjung Unik' : 'Total Impresi' %></span>
      </div>
      <div class="metric-num"><%= report && report.summary ? Number(report.summary.impressions).toLocaleString('id-ID') : 0 %></div>
      <div class="metric-lbl"><%= provider === 'adcash' ? 'Akumulasi Unique Visitors' : 'Total Tayangan Iklan' %></div>
    </div>

    <!-- KPI 2: Clicks -->
    <div class="metric-box" style="--box-accent:#7c3aed;--icon-bg:#f5f3ff">
      <div class="metric-top">
        <div class="metric-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m10 15 5-3-5-3v6z"/><circle cx="12" cy="12" r="10"/></svg>
        </div>
        <span class="metric-tag">Interaksi</span>
      </div>
      <div class="metric-num"><%= report && report.summary ? Number(report.summary.clicks).toLocaleString('id-ID') : 0 %></div>
      <div class="metric-lbl">Total Klik Pengunjung</div>
    </div>

    <!-- KPI 3: CTR & eCPM -->
    <div class="metric-box" style="--box-accent:#d97706;--icon-bg:#fffbeb">
      <div class="metric-top">
        <div class="metric-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <span class="metric-tag">eCPM: $<%= report && report.summary ? report.summary.cpm : 0 %></span>
      </div>
      <div class="metric-num"><%= report && report.summary ? report.summary.ctr : 0 %>%</div>
      <div class="metric-lbl">Rata-rata Click-Through Rate (CTR)</div>
    </div>

    <!-- KPI 4: Revenue -->
    <div class="metric-box" style="--box-accent:#059669;--icon-bg:#ecfdf5">
      <div class="metric-top">
        <div class="metric-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <span class="metric-tag"><%= report && report.currency ? report.currency : 'USD' %></span>
      </div>
      <div class="metric-num" style="color:#059669">$<%= report && report.summary ? Number(report.summary.revenue).toLocaleString('en-US', {minimumFractionDigits:3, maximumFractionDigits:4}) : '0.000' %></div>
      <div class="metric-lbl">Estimasi Pendapatan Akumulasi</div>
    </div>
  </div>

  <!-- Interactive Visual Chart -->
  <div class="panel" style="border-radius:14px;overflow:hidden;box-shadow:var(--a-shadow-sm)">
    <div class="panel-head" style="padding:16px 20px;background:#ffffff;border-bottom:1px solid var(--a-line)">
      <h3 style="font-size:15px;font-weight:700;display:flex;align-items:center;gap:8px">
        <span class="hd-ic" style="color:var(--a-brand)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></span>
        Grafik Tren Performa (<%= provider === 'adcash' ? 'Adcash' : 'Adsterra' %>)
      </h3>
      <span style="font-size:12px;color:var(--a-muted)">Periode: <b><%= report ? report.startDate : '' %></b> s/d <b><%= report ? report.endDate : '' %></b></span>
    </div>
    <div class="panel-body" style="padding:24px;background:#ffffff">
      <div style="position:relative;height:290px;width:100%">
        <canvas id="adcashChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Dual Tables: Zones/Placements & Daily Logs -->
  <div class="grid-2" style="gap:20px">
    <!-- Table: Placement / Zone Breakdown -->
    <div class="panel" style="border-radius:14px;overflow:hidden;box-shadow:var(--a-shadow-sm);background:#ffffff">
      <div class="panel-head" style="padding:16px 20px;border-bottom:1px solid var(--a-line)">
        <h3 style="font-size:14.5px;font-weight:700;display:flex;align-items:center;gap:8px">
          <span class="hd-ic" style="color:#2563eb"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg></span>
          Rincian Zone / Placement
        </h3>
        <span class="badge" style="background:var(--a-line-2);color:var(--a-ink-2);font-weight:700"><%= (report && report.placementRows) ? report.placementRows.length : 0 %> Penempatan</span>
      </div>
      <div class="panel-body flush">
        <div class="table-responsive">
          <table class="ad-table">
            <thead>
              <tr>
                <th>Penempatan</th>
                <th style="text-align:right"><%= provider === 'adcash' ? 'Visitors' : 'Impresi' %></th>
                <th style="text-align:right">Klik</th>
                <th style="text-align:right">eCPM</th>
                <th style="text-align:right">Pendapatan</th>
              </tr>
            </thead>
            <tbody>
              <% if (!report || !report.placementRows || !report.placementRows.length) { %>
                <tr>
                  <td colspan="5" style="text-align:center;padding:32px;color:var(--a-muted)">Tidak ada data penempatan aktif pada periode ini.</td>
                </tr>
              <% } else { %>
                <% report.placementRows.forEach(function(p) { %>
                  <tr>
                    <td>
                      <div style="font-weight:700;color:var(--a-ink)"><%= p.title %></div>
                      <div style="font-size:11px;color:var(--a-muted);font-family:var(--a-mono)">ID: <%= p.placementId %> <% if (p.alias) { %>(<%= p.alias %>)<% } %></div>
                    </td>
                    <td style="text-align:right;font-weight:700"><%= Number(p.impressions).toLocaleString('id-ID') %></td>
                    <td style="text-align:right;font-weight:700"><%= Number(p.clicks).toLocaleString('id-ID') %></td>
                    <td style="text-align:right;color:var(--a-muted);font-family:var(--a-mono)">$<%= Number(p.cpm).toFixed(2) %></td>
                    <td style="text-align:right;font-weight:800;color:var(--a-success)">$<%= Number(p.revenue).toFixed(4) %></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Table: Daily Timeline -->
    <div class="panel" style="border-radius:14px;overflow:hidden;box-shadow:var(--a-shadow-sm);background:#ffffff">
      <div class="panel-head" style="padding:16px 20px;border-bottom:1px solid var(--a-line)">
        <h3 style="font-size:14.5px;font-weight:700;display:flex;align-items:center;gap:8px">
          <span class="hd-ic" style="color:#7c3aed"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span>
          Riwayat Harian
        </h3>
        <span class="badge" style="background:var(--a-line-2);color:var(--a-ink-2);font-weight:700"><%= (report && report.dailyRows) ? report.dailyRows.length : 0 %> Hari</span>
      </div>
      <div class="panel-body flush">
        <div class="table-responsive">
          <table class="ad-table">
            <thead>
              <tr>
                <th>Tanggal</th>
                <th style="text-align:right"><%= provider === 'adcash' ? 'Visitors' : 'Impresi' %></th>
                <th style="text-align:right">Klik</th>
                <th style="text-align:right">eCPM</th>
                <th style="text-align:right">Pendapatan</th>
              </tr>
            </thead>
            <tbody>
              <% if (!report || !report.dailyRows || !report.dailyRows.length) { %>
                <tr>
                  <td colspan="5" style="text-align:center;padding:32px;color:var(--a-muted)">Belum ada data harian tercatat.</td>
                </tr>
              <% } else { %>
                <% report.dailyRows.forEach(function(d) { %>
                  <tr>
                    <td><span class="badge" style="background:#f1f5f9;color:var(--a-ink-2);font-family:var(--a-mono);font-size:11.5px"><%= d.date %></span></td>
                    <td style="text-align:right;font-weight:700"><%= Number(d.impressions).toLocaleString('id-ID') %></td>
                    <td style="text-align:right;font-weight:700"><%= Number(d.clicks).toLocaleString('id-ID') %></td>
                    <td style="text-align:right;color:var(--a-muted);font-family:var(--a-mono)">$<%= Number(d.cpm).toFixed(2) %></td>
                    <td style="text-align:right;font-weight:800;color:var(--a-success)">$<%= Number(d.revenue).toFixed(4) %></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Konfigurasi API Key (Clean Modal dengan Show/Hide Password Toggle) -->
<div id="apiConfigModal" class="lightbox">
  <div class="panel" style="width:min(600px,94vw);margin:auto;box-shadow:var(--a-shadow-lg);border-radius:18px;background:var(--a-surface);overflow:hidden;border:none">
    <div class="panel-head" style="padding:20px 24px;border-bottom:1px solid var(--a-line);background:#ffffff">
      <div>
        <h3 style="margin:0 0 2px 0;font-size:16px;font-weight:800;display:flex;align-items:center;gap:8px">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Pengaturan Kunci API Jaringan Iklan
        </h3>
        <div style="font-size:12px;color:var(--a-muted)">Kunci disimpan terenkripsi secara otomatis menggunakan AES-256-GCM.</div>
      </div>
      <button type="button" class="btn-icon" onclick="document.getElementById('apiConfigModal').classList.remove('open')" style="border:none;background:none;cursor:pointer;padding:4px">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    
    <div style="padding:24px;background:#ffffff">
      <!-- Section Adsterra -->
      <form action="/admin/statistik-iklan/config" method="POST" style="margin-bottom:24px;padding-bottom:22px;border-bottom:1px solid var(--a-line)">
        <input type="hidden" name="provider" value="adsterra">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <div style="display:flex;align-items:center;gap:6px">
            <span style="width:7px;height:7px;border-radius:50%;background:#10b981"></span>
            <label style="font-weight:800;font-size:13.5px;color:var(--a-ink)">Adsterra Network API Key</label>
          </div>
          <span style="font-size:11px;color:var(--a-muted);font-family:var(--a-mono)">Header X-API-Key</span>
        </div>
        <div style="position:relative;margin-bottom:10px">
          <input type="password" id="inputKeyAdsterra" name="api_token" value="<%= adsterraToken || '' %>" placeholder="Tempel API Key Adsterra…" class="input" style="width:100%;padding-right:44px;font-family:var(--a-mono);font-size:12px;border-radius:10px" required>
          <button type="button" onclick="const f=document.getElementById('inputKeyAdsterra');f.type=f.type==='password'?'text':'password';" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);border:none;background:none;color:var(--a-muted);cursor:pointer;padding:6px" title="Lihat / Sembunyikan Isi Key">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        <div style="display:flex;justify-content:flex-end">
          <button type="submit" class="btn btn-sm btn-primary" style="border-radius:8px">Simpan Kunci Adsterra</button>
        </div>
      </form>

      <!-- Section Adcash -->
      <form action="/admin/statistik-iklan/config" method="POST">
        <input type="hidden" name="provider" value="adcash">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <div style="display:flex;align-items:center;gap:6px">
            <span style="width:7px;height:7px;border-radius:50%;background:#3b82f6"></span>
            <label style="font-weight:800;font-size:13.5px;color:var(--a-ink)">Adcash Publisher API v2 Token</label>
          </div>
          <span style="font-size:11px;color:var(--a-muted);font-family:var(--a-mono)">Base64 Token</span>
        </div>
        <div style="position:relative;margin-bottom:10px">
          <input type="password" id="inputKeyAdcash" name="api_token" value="<%= adcashToken || '' %>" placeholder="Tempel API Token Adcash (base64)…" class="input" style="width:100%;padding-right:44px;font-family:var(--a-mono);font-size:12px;border-radius:10px" required>
          <button type="button" onclick="const f=document.getElementById('inputKeyAdcash');f.type=f.type==='password'?'text':'password';" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);border:none;background:none;color:var(--a-muted);cursor:pointer;padding:6px" title="Lihat / Sembunyikan Isi Key">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        <div style="font-size:11.5px;color:var(--a-muted);margin-bottom:14px;line-height:1.4">
          Token ini otomatis ditukarkan ke endpoint OAuth Adcash untuk mendapatkan Bearer Token tiap 15 menit.
        </div>
        <div style="display:flex;justify-content:flex-end">
          <button type="submit" class="btn btn-sm btn-primary" style="border-radius:8px">Simpan Kunci Adcash</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Chart.js via CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
// Click to toggle Key Visibility
let isKeyRevealed = false;
function toggleKeyVisibility() {
  isKeyRevealed = !isKeyRevealed;
  const masked = document.getElementById('keyMaskedText');
  const actual = document.getElementById('keyActualText');
  const action = document.getElementById('keyActionText');
  if (isKeyRevealed) {
    masked.style.display = 'none';
    actual.style.display = 'inline';
    action.textContent = 'Sembunyikan';
    action.style.color = 'var(--a-muted)';
  } else {
    masked.style.display = 'inline';
    actual.style.display = 'none';
    action.textContent = 'Klik Buka';
    action.style.color = 'var(--a-brand)';
  }
}

// Chart Generation
document.addEventListener('DOMContentLoaded', () => {
  const ctx = document.getElementById('adcashChart');
  if (!ctx) return;

  const daily = <%- JSON.stringify((report && report.dailyRows) ? report.dailyRows : []) %>;
  const labels = daily.map(d => d.date);
  const dataImps = daily.map(d => d.impressions);
  const dataClicks = daily.map(d => d.clicks);
  const dataRevenue = daily.map(d => d.revenue);

  new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels.length ? labels : ['Hari Ini'],
      datasets: [
        {
          label: '<%= provider === "adcash" ? "Visitors" : "Impresi" %>',
          data: dataImps.length ? dataImps : [0],
          borderColor: '#2563eb',
          backgroundColor: 'rgba(37, 99, 235, 0.06)',
          fill: true,
          tension: 0.35,
          borderWidth: 2.2,
          pointRadius: 4,
          pointHoverRadius: 6,
          yAxisID: 'y'
        },
        {
          label: 'Klik',
          data: dataClicks.length ? dataClicks : [0],
          borderColor: '#7c3aed',
          backgroundColor: 'transparent',
          borderDash: [4, 4],
          tension: 0.35,
          borderWidth: 2,
          pointRadius: 4,
          yAxisID: 'y'
        },
        {
          label: 'Pendapatan ($)',
          data: dataRevenue.length ? dataRevenue : [0],
          borderColor: '#059669',
          backgroundColor: 'transparent',
          tension: 0.35,
          borderWidth: 2.5,
          pointRadius: 4,
          pointHoverRadius: 6,
          yAxisID: 'y1'
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: {
        mode: 'index',
        intersect: false
      },
      plugins: {
        legend: {
          position: 'top',
          align: 'end',
          labels: {
            boxWidth: 12,
            usePointStyle: true,
            font: { family: 'Plus Jakarta Sans', size: 12, weight: 600 }
          }
        },
        tooltip: {
          padding: 12,
          boxPadding: 6,
          cornerRadius: 8,
          titleFont: { family: 'Plus Jakarta Sans', size: 12.5, weight: 700 },
          bodyFont: { family: 'Plus Jakarta Sans', size: 12 }
        }
      },
      scales: {
        x: {
          grid: { color: 'rgba(0,0,0,0.03)' },
          ticks: { font: { family: 'Plus Jakarta Sans', size: 11 } }
        },
        y: {
          type: 'linear',
          display: true,
          position: 'left',
          grid: { color: 'rgba(0,0,0,0.04)' },
          ticks: { precision: 0 }
        },
        y1: {
          type: 'linear',
          display: true,
          position: 'right',
          grid: { drawOnChartArea: false },
          ticks: {
            callback: function(val) { return '$' + Number(val).toFixed(3); }
          }
        }
      }
    }
  });
});
</script>
