<div class="page-head">
  <div>
    <h2>Statistik Iklan &amp; Monetisasi</h2>
    <div class="desc">Pantau performa impresi, klik, CTR, eCPM, dan pendapatan iklan publisher secara real-time.</div>
  </div>
  <div class="h-stack">
    <% if (report && report.configured && !report.error) { %>
      <a href="/admin/statistik-iklan?period=<%= period %>&refresh=1" class="btn btn-ghost btn-sm" title="Segarkan Data Sekarang">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.19"/></svg>
        <span>Segarkan (Refresh)</span>
      </a>
    <% } %>
    <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('apiConfigModal').classList.add('open')">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      <span>Pengaturan API Key</span>
    </button>
  </div>
</div>

<% if (msg === 'token-saved') { %>
  <div class="alert alert-success" style="margin-bottom:20px;padding:12px 16px;border-radius:8px;background:var(--a-success-bg);color:var(--a-success);border:1px solid rgba(15,157,88,0.2);display:flex;align-items:center;gap:10px">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    <span>API Key berhasil disimpan dengan aman (terenkripsi AES-256-GCM di database).</span>
  </div>
<% } %>

<% if (report && report.error) { %>
  <div class="alert alert-danger" style="margin-bottom:24px;padding:16px 20px;border-radius:10px;background:#fef2f2;color:#991b1b;border:1px solid #fecaca;display:flex;align-items:flex-start;gap:12px">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <div>
      <b style="display:block;font-size:14.5px;margin-bottom:4px">Koneksi API Gagal</b>
      <p style="margin:0;font-size:13px;line-height:1.5"><%= report.error %></p>
      <div style="margin-top:10px">
        <button type="button" class="btn btn-sm btn-ghost" onclick="document.getElementById('apiConfigModal').classList.add('open')" style="color:#991b1b;border-color:#fca5a5;background:#fff">Perbarui API Key</button>
      </div>
    </div>
  </div>
<% } %>

<!-- Filter Periode Tab -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px">
  <div class="tabs-group" style="display:inline-flex;background:var(--a-surface);padding:4px;border-radius:10px;border:1px solid var(--a-line)">
    <a href="/admin/statistik-iklan?period=today" class="btn btn-sm <%= period === 'today' ? 'btn-primary' : 'btn-ghost' %>" style="border-radius:7px">Hari Ini</a>
    <a href="/admin/statistik-iklan?period=week" class="btn btn-sm <%= period === 'week' ? 'btn-primary' : 'btn-ghost' %>" style="border-radius:7px">7 Hari Terakhir</a>
    <a href="/admin/statistik-iklan?period=month" class="btn btn-sm <%= period === 'month' ? 'btn-primary' : 'btn-ghost' %>" style="border-radius:7px">30 Hari Terakhir</a>
  </div>

  <div style="font-size:12px;color:var(--a-muted);display:flex;align-items:center;gap:14px">
    <% if (report && report.dbLastUpdateTime) { %>
      <span>Terakhir Update Server: <b><%= report.dbLastUpdateTime %></b></span>
    <% } %>
    <% if (report && report.cached) { %>
      <span style="display:inline-flex;align-items:center;gap:5px;background:var(--a-line-2);padding:3px 8px;border-radius:6px">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Cache aktif (<%= new Date(report.cacheTime).toLocaleTimeString('id-ID') %>)
      </span>
    <% } %>
  </div>
</div>

<!-- Kartu Ringkasan Statistik -->
<div class="stats-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom:24px">
  <div class="stat-card" style="--brand-c:#2563eb;--bg-c:#eff6ff">
    <div class="stat-head">
      <div class="ic">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
      </div>
      <span class="trend">Impresi</span>
    </div>
    <div class="value"><%= report && report.summary ? Number(report.summary.impressions).toLocaleString('id-ID') : 0 %></div>
    <div class="label">Total Impresi Iklan</div>
  </div>

  <div class="stat-card" style="--brand-c:#7c3aed;--bg-c:#f5f3ff">
    <div class="stat-head">
      <div class="ic">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="m10 15 5-3-5-3v6z"/></svg>
      </div>
      <span class="trend">Klik</span>
    </div>
    <div class="value"><%= report && report.summary ? Number(report.summary.clicks).toLocaleString('id-ID') : 0 %></div>
    <div class="label">Total Interaksi / Klik</div>
  </div>

  <div class="stat-card" style="--brand-c:#f59e0b;--bg-c:#fffbeb">
    <div class="stat-head">
      <div class="ic">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
      </div>
      <span class="trend">CTR (<%= report && report.summary ? report.summary.cpm : 0 %> CPM)</span>
    </div>
    <div class="value"><%= report && report.summary ? report.summary.ctr : 0 %>%</div>
    <div class="label">Rata-rata Click-Through Rate</div>
  </div>

  <div class="stat-card" style="--brand-c:#059669;--bg-c:#ecfdf5">
    <div class="stat-head">
      <div class="ic">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      </div>
      <span class="trend"><%= report && report.currency ? report.currency : 'USD' %></span>
    </div>
    <div class="value">$<%= report && report.summary ? Number(report.summary.revenue).toLocaleString('en-US', {minimumFractionDigits:3, maximumFractionDigits:4}) : '0.000' %></div>
    <div class="label">Pendapatan Terakumulasi</div>
  </div>
</div>

<!-- Grafik Visualisasi Tren Harian -->
<div class="panel" style="margin-bottom:24px">
  <div class="panel-head">
    <h3>
      <span class="hd-ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></span>
      Grafik Tren Impresi, Klik &amp; Pendapatan
    </h3>
    <span style="font-size:12px;color:var(--a-muted)">Rentang: <%= report ? report.startDate : '' %> s/d <%= report ? report.endDate : '' %></span>
  </div>
  <div class="panel-body" style="padding:20px">
    <div style="position:relative;height:270px;width:100%">
      <canvas id="adcashChart"></canvas>
    </div>
  </div>
</div>

<!-- Grid 2 Kolom: Laporan per Placement & Riwayat Harian -->
<div class="grid-2" style="margin-bottom:24px">
  <!-- Tabel Performa per Zone / Placement -->
  <div class="panel">
    <div class="panel-head">
      <h3>
        <span class="hd-ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg></span>
        Performa per Placement / Zone
      </h3>
      <span class="badge badge-muted"><%= (report && report.placementRows) ? report.placementRows.length : 0 %> Penempatan</span>
    </div>
    <div class="panel-body flush">
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>ID &amp; Penempatan</th>
              <th style="text-align:right">Impresi</th>
              <th style="text-align:right">Klik</th>
              <th style="text-align:right">CTR</th>
              <th style="text-align:right">Pendapatan</th>
            </tr>
          </thead>
          <tbody>
            <% if (!report || !report.placementRows || !report.placementRows.length) { %>
              <tr>
                <td colspan="5" style="text-align:center;padding:24px;color:var(--a-muted)">Tidak ada data placement aktif pada periode ini.</td>
              </tr>
            <% } else { %>
              <% report.placementRows.forEach(function(p) { %>
                <tr>
                  <td>
                    <b><%= p.title %></b>
                    <div style="font-size:11px;color:var(--a-muted);font-family:var(--a-mono)">ID: <%= p.placementId %></div>
                  </td>
                  <td style="text-align:right;font-weight:600"><%= Number(p.impressions).toLocaleString('id-ID') %></td>
                  <td style="text-align:right;font-weight:600"><%= Number(p.clicks).toLocaleString('id-ID') %></td>
                  <td style="text-align:right"><span class="badge <%= p.ctr > 1 ? 'badge-cat' : 'badge-muted' %>"><%= p.ctr %>%</span></td>
                  <td style="text-align:right;font-weight:700;color:var(--a-success)">$<%= Number(p.revenue).toFixed(4) %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Tabel Riwayat Harian -->
  <div class="panel">
    <div class="panel-head">
      <h3>
        <span class="hd-ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span>
        Riwayat Statistik Harian
      </h3>
      <span class="badge badge-muted"><%= (report && report.dailyRows) ? report.dailyRows.length : 0 %> Hari</span>
    </div>
    <div class="panel-body flush">
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Tanggal</th>
              <th style="text-align:right">Impresi</th>
              <th style="text-align:right">Klik</th>
              <th style="text-align:right">eCPM</th>
              <th style="text-align:right">Pendapatan</th>
            </tr>
          </thead>
          <tbody>
            <% if (!report || !report.dailyRows || !report.dailyRows.length) { %>
              <tr>
                <td colspan="5" style="text-align:center;padding:24px;color:var(--a-muted)">Belum ada data harian tercatat.</td>
              </tr>
            <% } else { %>
              <% report.dailyRows.forEach(function(d) { %>
                <tr>
                  <td><span class="badge badge-muted"><%= d.date %></span></td>
                  <td style="text-align:right;font-weight:600"><%= Number(d.impressions).toLocaleString('id-ID') %></td>
                  <td style="text-align:right;font-weight:600"><%= Number(d.clicks).toLocaleString('id-ID') %></td>
                  <td style="text-align:right;color:var(--a-muted)">$<%= d.cpm %></td>
                  <td style="text-align:right;font-weight:700;color:var(--a-success)">$<%= Number(d.revenue).toFixed(4) %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal Konfigurasi API Key -->
<div id="apiConfigModal" class="lightbox">
  <div class="panel" style="width:min(540px,94vw);margin:auto;box-shadow:var(--a-shadow-lg);border-radius:16px;background:var(--a-surface);overflow:hidden">
    <div class="panel-head" style="padding:18px 24px;border-bottom:1px solid var(--a-line)">
      <h3 style="display:flex;align-items:center;gap:10px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83-2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        Konfigurasi Publisher Reporting API
      </h3>
      <button type="button" class="btn-icon" onclick="document.getElementById('apiConfigModal').classList.remove('open')" style="border:none;background:none;cursor:pointer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    
    <form action="/admin/statistik-iklan/config" method="POST" style="padding:24px">
      <div style="font-size:13px;color:var(--a-muted);margin-bottom:16px;line-height:1.5">
        Masukkan <b>API Key / Token</b> Publisher. Kunci ini akan disimpan dalam format <b>terenkripsi AES-256-GCM</b> di database agar aman dari kebocoran data.
      </div>

      <div class="field" style="margin-bottom:18px">
        <label style="display:block;font-weight:700;font-size:13px;margin-bottom:6px">Publisher API Key (X-API-Key)</label>
        <div style="position:relative">
          <input type="password" id="apiTokenInput" name="adcash_api_token" value="<%= currentToken || '' %>" placeholder="Tempel API Key di sini…" class="input" style="width:100%;padding-right:44px;font-family:var(--a-mono);font-size:12.5px" required>
          <button type="button" onclick="const f=document.getElementById('apiTokenInput');f.type=f.type==='password'?'text':'password';" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);border:none;background:none;color:var(--a-muted);cursor:pointer;padding:6px">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:24px">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('apiConfigModal').classList.remove('open')">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan &amp; Verifikasi API</button>
      </div>
    </form>
  </div>
</div>

<!-- Chart.js Library via CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const ctx = document.getElementById('adcashChart');
  if (!ctx) return;

  const daily = <%- JSON.stringify((report && report.dailyRows) ? report.dailyRows : []) %>;
  const labels = daily.map(d => d.date);
  const dataImps = daily.map(d => d.impressions);
  const dataClicks = daily.map(d => d.clicks);
  const dataRevenue = daily.map(d => d.revenue);

  new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels.length ? labels : ['Hari Ini'],
      datasets: [
        {
          label: 'Impresi',
          data: dataImps.length ? dataImps : [0],
          borderColor: '#2563eb',
          backgroundColor: 'rgba(37, 99, 235, 0.08)',
          fill: true,
          tension: 0.35,
          yAxisID: 'y'
        },
        {
          label: 'Klik',
          data: dataClicks.length ? dataClicks : [0],
          borderColor: '#7c3aed',
          backgroundColor: 'transparent',
          borderDash: [5, 5],
          tension: 0.35,
          yAxisID: 'y1'
        },
        {
          label: 'Pendapatan ($)',
          data: dataRevenue.length ? dataRevenue : [0],
          borderColor: '#059669',
          backgroundColor: 'transparent',
          tension: 0.35,
          yAxisID: 'y2'
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: {
        mode: 'index',
        intersect: false
      },
      scales: {
        y: {
          type: 'linear',
          display: true,
          position: 'left',
          grid: { color: 'rgba(0,0,0,0.04)' }
        },
        y1: {
          type: 'linear',
          display: false,
          position: 'right'
        },
        y2: {
          type: 'linear',
          display: true,
          position: 'right',
          grid: { drawOnChartArea: false },
          ticks: {
            callback: function(val) { return '$' + Number(val).toFixed(3); }
          }
        }
      }
    }
  });
});
</script>
